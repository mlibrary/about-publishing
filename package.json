{
  "name": "gatsby-starter-default",
  "private": true,
  "description": "A simple starter to get up and developing quickly with Gatsby",
  "version": "0.1.0",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mdx-js/mdx": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "@umich-lib/core": "^2.0.6",
    "axios": "^1.7.2",
    "date-fns": "^2.30.0",
    "decap-cms-app": "^3.1.7",
    "gatsby": "^5.16.0",
    "gatsby-plugin-decap-cms": "^4.0.4",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-google-tagmanager": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-transition-link": "^1.20.5",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "gsap": "^3.12.5",
    "jquery": "^3.7.1",
    "markdown-it": "^14.1.0",
    "numeral": "^2.0.6",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "showdown": "^2.1.0",
    "typeface-crimson-text": "0.0.72",
    "typeface-muli": "0.0.71"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.11.0",
    "postcss-loader": "^7.3.4",
    "style-loader": "^3.3.4",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4"
  },
  "scripts": {
    "generate-cms-config": "node scripts/generate-cms-config.js",
    "build:cms": "npm run generate-cms-config && webpack --config webpack.cms.js",
    "build": "npm run build:cms && gatsby build",
    "develop": "npm run build:cms && gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing \""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}